# ── Required ────────────────────────────────────────────────────────────────────

# Telegram bot token from @BotFather
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Anthropic API key from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Quidli Connect API key from https://connect.quid.li
QUIDLI_API_KEY=your_quidli_api_key_here

# ── Optional ─────────────────────────────────────────────────────────────────

CLAUDE_MODEL=claude-sonnet-4-6
SYSTEM_PROMPT=
TELEGRAM_ALLOWED_USERS=
BOT_OWNER_ID=
MASTER_ENCRYPTION_KEY=
BRAVE_SEARCH_API_KEY=
DEFAULT_LLM_PROVIDER=anthropic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Nous Portal (Hermes) — get a key at portal.nousresearch.com (API keys tab).
# Portal is an OpenRouter-compatible proxy for 200+ models; slugs are vendor-prefixed
# and free variants carry a ':free' suffix.
# Free-tier models that support tool calling (verified via GET /v1/models):
#   tencent/hy3:free, inclusionai/ling-3.0-flash:free, poolside/laguna-s-2.1:free,
#   poolside/laguna-xs-2.1:free, stepfun/step-3.7-flash:free
# Paid tiers can use any slug (anthropic/claude-sonnet-4.6, openai/gpt-5.5, etc).
# Note: Nous's own docs say the Hermes-4-* models specifically aren't tuned for
# rapid-fire tool-calling loops, so prefer an agentic model for drop/lookup work.
# Users can override per-chat with: /llm hermes <key> <model>
NOUS_API_KEY=
NOUS_MODEL=tencent/hy3:free

# Set to 'true' to require users to connect their own LLM API key before using the bot.
# If 'false' (default), all users share the host's key.
REQUIRE_USER_LLM_KEY=false
BOT_WALLET_PRIVATE_KEY=
BOT_WALLET_ADDRESS=
